# --- Stillō bot configuration ---
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env

# Токен бота от @BotFather (обязательно).
# Получить: /newbot -> следуй инструкциям -> скопируй токен вида 123456:ABC-DEF...
BOT_TOKEN=

# URL Mini App (GitHub Pages). Можно не менять, если используешь стандартный.
WEBAPP_URL=https://msaidamir98-spec.github.io/StopPanic/app/

# Username для вопросов по платежам/возвратам, без @ (для /paysupport).
SUPPORT_USERNAME=your_username
